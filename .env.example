OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Optional: without these, the Playground's rate limiting falls back to an in-memory counter
# (fine for local dev, not for a real deployment - it resets on restart and isn't shared
# across server instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global daily cap on live Jev calls from the Playground (section 10.3), counted by call count.
GLOBAL_DAILY_CAP=500
